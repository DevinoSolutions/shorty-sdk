{
    "name": "@aishorty/sdk",
    "version": "0.1.0",
    "description": "Official TypeScript SDK for the Shorty public API (aishorty.com/v1).",
    "license": "MIT",
    "author": "Devino Solutions",
    "homepage": "https://aishorty.com/developers",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DevinoSolutions/shorty-sdk.git"
    },
    "bugs": {
        "url": "https://github.com/DevinoSolutions/shorty-sdk/issues"
    },
    "keywords": [
        "shorty",
        "aishorty",
        "transcription",
        "summaries",
        "subtitles",
        "api",
        "sdk"
    ],
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test \"test/**/*.test.ts\"",
        "test:unit": "tsx --test \"test/**/*.test.ts\"",
        "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "changeset publish"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.1",
        "@types/node": "^20.12.11",
        "tsup": "^8.5.1",
        "tsx": "^4.23.1",
        "typescript": "^5.8.3"
    }
}
